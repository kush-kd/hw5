# Campus Customs HW5: example environment. Copy to .env if you want to override defaults.
# NEVER commit a real .env (it is git-ignored).
#
# No AI API key is needed: every agent turn runs on Opus 5.5 (claude-opus-5-5) through the
# Claude Code CLI (`claude -p`), logged in with a Claude subscription. The model bridge passes
# the CLI only a minimal allowlist of environment variables (see backend/llm/claude_subscription.py).

# Working database used by the MCP server (the backend always points it at this file).
CAMPUS_CUSTOMS_DB=data/campus_customs_new.db

# Secret the backend uses to call the human-only approve/pay MCP tools.
# Leave empty and the backend generates a random one at startup (agents never receive it).
HUMAN_APPROVAL_KEY=

# Frontend (put in frontend/.env): where the FastAPI backend runs.
VITE_API_BASE=http://localhost:8000
